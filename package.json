{
  "name": "applywizz-signal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:users": "node --env-file=apps/web/.env.local scripts/seed-local-users.mjs",
    "eval:m8-language": "tsx packages/domain/scripts/m8-language-eval.ts",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
