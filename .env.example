# Copy the values you need into apps/web/.env.local for local development.
# Never commit real secrets — this file only documents variable names.

# --- Client-safe (exposed to the browser via NEXT_PUBLIC_ prefix) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets (must never reach client code) ---
SUPABASE_SERVICE_ROLE_KEY=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_WEBHOOK_CLIENT_STATE=

VEXA_BASE_URL=
VEXA_API_KEY=

OPENAI_API_KEY=

EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

APPLYWIZZ_CRM_BASE_URL=
APPLYWIZZ_CRM_API_KEY=

APPLYWIZZ_CUSTOMER_DETAILS_BASE_URL=
APPLYWIZZ_CUSTOMER_DETAILS_API_KEY=

APP_BASE_URL=
WEBHOOK_BASE_URL=
ENCRYPTION_KEY=
INTERNAL_QUEUE_SECRET=
LOG_LEVEL=info

# --- Transcription (server/worker only; never NEXT_PUBLIC_) ---
# Production primary must be azure-mai. Code defaults remain openrouter for
# safe local/dev unless this is set. Do not omit Azure keys when primary is azure-mai.
TRANSCRIPTION_PRIMARY_PROVIDER=azure-mai
AZURE_MAI_ENDPOINT=
AZURE_MAI_KEY=
AZURE_MAI_REGION=

# Whisper safety fallback + English normalization (still required when Azure is primary)
OPENROUTER_API_KEY=
